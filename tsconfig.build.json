{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "declaration": true,
    "declarationDir": "./dist/types",
    "emitDeclarationOnly": true,
    "sourceMap": true
  },
  "include": [
    "src/index.ts",
    "src/setup.ts",
    "src/install.ts",
    "src/transport/broadcast-channel.ts",
    "src/lib/**/*"
  ],
  "exclude": ["src/**/*.spec.ts"]
}
